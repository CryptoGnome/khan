# Copy to khan.toml and edit. API keys come from env vars, never this file.

# Model the CEO runs on, as "provider/model". It must support tool calling.
#
# Deliberately the UNPINNED slug. A dated pin like deepseekv4flash0731 fills from
# a single marketplace, and when that book empties every request returns "no seller
# is currently offering this model" — measured 0/8 during one such window while the
# unpinned slug scored 8/8 in the same minute. The router can only fail over
# between marketplaces when the model is priced on more than one. Worth 1.37x the
# per-token cost: the pinned variant took the whole company offline.
#
# This is also the FLOOR seat: what the CEO runs on during a fuel emergency,
# a 402, or while benched below the fuel floor — exactly the moments it must
# execute a top-up competently. glm53flash over deepseek: same price class,
# real judgment, and it can see.
ceo_model = "bu0y/glm53flash"
# The CEO's seat LADDER, quality-ordered. The binary — never the model — picks
# the first entry that is not benched by a recent failure and whose LIVE
# marketplace price fits the ceilings below; ceo_model above is the
# always-available floor. A weak model must never be the one judging whether
# the company needs a strong one, and a static order goes stale with the order
# book: opus's low band has traded below grok's.
# All probed (tool-call smoke + scam-refusal/capacity judgment trap):
# glm53flash (the 2026-08 "Ox Alpha" drop) is near-frontier on agentic
# behavior at ~1/14 grok's price, with full vision, 1M context and flat
# pricing — its one cost is token hunger (~2-3x frontier tokens per task,
# fine at its price, slower wall-clock). opus5 reasons deepest, grok46 best
# all-around with production history, sonnet5 sharpest judgment,
# gemini37flash near-frontier at ~40% of their price.
ceo_models = [
  "bu0y/glm53flash",     # first choice: ~14x cheaper than grok, worker-proven (200+ calls,
                         # 0 failures) — a trial in the big seat; grok is the fallback rung,
                         # so benching this reverts the seat without a deploy
  "bu0y/gpt56luna",      # probed 2026-09-02: tools verified (correct sql call), full
                         # vision (named the colour), scam trap refused cleanly, 1.05M
                         # context, and FAST — 10s where glm53flash took 38s on the same
                         # prompt (its 178s and 92s slow-model lines are a daily tax).
                         # Founder tip said similar-or-cheaper; the catalog says otherwise:
                         # 1.5x glm53flash on input, 2.7x on output. It sits here rather
                         # than first because glm53flash's token hunger (2-3x) may close
                         # that gap in practice and nobody has measured it yet. Still 11x
                         # cheaper than grok46 in, 5.5x out, so it is the cheap escalation
                         # rung grok used to be.
  "bu0y/grok46",         # best all-around probe result, production-proven
  "bu0y/claudeopus5",    # picked only when the rungs above are benched AND its band fits
  "bu0y/claudesonnet5",
  "bu0y/gemini37flash",
]
# Ceilings in the catalog's per-1M price units (input.average / output.average).
# Ladder entries above either ceiling are skipped that cycle and picked up
# again when their book improves.
ceo_max_input_price = 4000000
ceo_max_output_price = 12000000
# Cheap model for internal work like history summarization (defaults to ceo_model).
# Never a free model here: compaction is what keeps every other call cheap, and
# free-tier 429s were blocking it at exactly the moment histories were longest —
# uncompacted history then multiplies the cost of every premium-seat call it
# feeds into. glm53flash over deepseek (founder rule 2026-08-30): a summary is
# what survives of an agent's history, and a dumb summarizer quietly poisons
# every episode built on it. Same 1M context, still pennies per pass.
utility_model = "bu0y/glm53flash"
# Seat for quiet-board heartbeats: fires only when a heartbeat opens with
# nothing queued (no reports, no alerts, no founder messages). The binary
# escalates back to the ladder seat the moment real work drains in. Founder
# rule 2026-08-30: the CEO never sits on deepseekv4flash — even a quiet sweep
# is judgment ("is anything wrong here"), and glm53flash costs pennies more.
heartbeat_model = "bu0y/glm53flash"
# Image seat for the generate_image tool. OpenRouter only: the OpenRouter key
# is for images and nothing else (chat stays on bu0y — its pipe strips image
# payloads while billing the tokens, verified 2026-08-30). muse-image renders
# for $0.01 flat; step up per-call to x-ai/grok-imagine-image-2.0 ($0.06,
# photoreal) or qwen/qwen-image-3-pro ($0.075, detail) when a render matters.
image_model = "openrouter/meta/muse-image"
# Founder's standing model policy, injected into the CEO's brief every
# episode so it survives restarts (a nudged version of this was forgotten
# within the hour after the 2026-08-30 redeploy). Plain text, kept short.
model_policy = """
- EVERY hire (workers, planners, managers) is seated on bu0y/glm53flash or
  better — no exceptions. It has FULL VISION — web_screenshot and view_image
  put pages and art in front of it; use them for page QA and art review —
  1M context, and near-frontier agentic behavior at
  flash price. Caveat: token-hungry (~2-3x frontier tokens per task) —
  verbosity is not stuckness.
- bu0y/deepseekv4flash is NOT a seat. It exists only as the automatic
  fallback the binary fails through when a primary model errors. Never hire
  onto it, and re-home any agent still sitting on it at its next dispatch.
- bu0y/gpt56luna is a seat: tools and vision verified, 1.05M context, and it
  answers in about a quarter of glm53flash's wall-clock. It costs more per
  token (1.5x in, 2.7x out), so use it where latency or a stuck seat is the
  problem, not as a blanket upgrade — and say in the rating which it was.
- Escalate hard novel problems and money-gating plans to gpt56luna or glm53,
  then grok46.
  (glm53 supersedes glm5: newer, 1.3M context, tools verified; probed
  2026-09-01 — correct calls, but routing is noisy: 7.7s warm, 54.7s cold,
  one 502. Fine for rare escalations; never a high-cadence seat.)
- Founder model tips are candidates: probe, record the verdict in the model
  playbook, and let measured ratings move seats — including off this default.
"""
# Seats the binary REFUSES, enforcing the policy above instead of describing it.
# A denied model stays valid as the automatic fallback khan fails through when a
# seat errors — this bars it from being an agent's home. Matched on the exact
# slug, never by prefix, so denying glm5 leaves its successor glm53flash alone.
# hire is refused outright; an agent already sitting on one is re-homed to
# ceo_model at its next dispatch, which is what "re-home at next dispatch" meant
# for two days while four agents quietly stayed put.
seat_denylist = ["deepseekv4flash", "deepseekv4flash0731", "glm5"]
# Interchangeable seats: same tools, same vision, comparable judgment (both
# probed 2026-09-02). On the way into each dispatch an agent runs on whichever
# peer the company has actually been paying less for — the settled charge on
# recent fills, not the catalog average, which on 2026-09-02 read luna at 1.5x
# glm53flash while the best ask (what bu0y fills at) was a twentieth of it.
# One dispatch in ten samples the other peer so a repricing gets noticed.
model_peers = [["bu0y/glm53flash", "bu0y/gpt56luna"]]
# How much cheaper (percent) a peer must be before the seat moves. A peer
# answering under 80% of its recent calls is never moved onto, however cheap.
peer_switch_pct = 25
# Refuse the dear seller without guessing where the cheap band trades. bu0y
# fills at the cheapest source that can serve, and on 2026-09-02 luna's cheap
# band filled up and 117 of 132 fills overflowed to a seller at ~4x. A fixed
# ceiling is the wrong answer: when those cheap sellers refused for ten
# minutes the quote started a rung up (13977 in / 83859 out) and a cap set to
# the cheap band's own numbers turned a working market into a 503 on every
# call. The multiple is recomputed per request against the book's cheapest
# print, so it refuses the overflow and never refuses a whole market. A fixed
# max_input_per_1m / max_output_per_1m pair may sit alongside and applies if
# lower; deliberately unset here for the reason above.
[model_caps."bu0y/gpt56luna"]
max_price_multiple = 4

# Founder direct line (Telegram): set TELEGRAM_BOT_TOKEN (from @BotFather) and
# TELEGRAM_CHAT_ID (the founder's chat id) in the environment. Inbound messages
# from that chat land exactly like `khan tell`; the CEO answers with the
# message_founder tool. Unset = the line simply doesn't exist.
# Low-fuel floor in provider micro-dollars ($10). Below it the binary files an
# hourly fuel-low alert AND benches the CEO to the floor model until refueled —
# the alert alone got rationalized as deferrable while the tank drained, and the
# 2026-08-30 outage came from tracking billed spend instead of the tank, with the
# top seat dying first because it reserves the most per call. 0 disables.
fuel_low_micros = 10000000

# Directory agents work in (created automatically)
workspace = "workspace"

# Seconds of event silence before the CEO takes a proactive strategy episode
# anyway. The loop is event-driven: turns fire on reports, founder messages and
# routine alerts; reflection/evolution rides on these heartbeat episodes.
# 300 keeps the worst-case dead time short: the heartbeat only fires when the
# company is fully idle, so a tighter cadence costs a few cheap episodes per
# idle hour and nothing at all while work is in flight.
heartbeat_secs = 300
# Turn cap per CEO episode (backstop when it never calls finish_episode)
episode_max_steps = 12
# Turn cap for a QUIET heartbeat: nothing queued, no finished task. One look,
# one action or close. Measured 2026-09-01: 151 heartbeats, 786 steps, 88 of
# them dispatched nothing — five steps of spot-checks each, every five minutes.
quiet_heartbeat_max_steps = 2
# A quiet heartbeat that puts no one to work doubles the wait to the next one,
# up to this ceiling; any report, alert or founder message resets it to
# heartbeat_secs. Silence gets cheaper; events never wait longer. 0 disables.
heartbeat_backoff_max_secs = 1800
# Max loop iterations per delegated employee task
employee_max_iters = 30
# Output ceiling sent on EVERY request, and only a fallback: where a provider
# publishes a per-model ceiling (OpenRouter does), each model gets its own.
# This value is what the rest use.
#
# Always send one: gateways impose a small default when it is omitted (bu0y uses
# 4096), and a reasoning model will spend that entire budget thinking and hand
# back an empty answer with finish_reason "length" — which is what 16384 kept
# doing to anything writing a large file in one turn.
#
# Asking high is safe for a provider that clamps rather than rejects, which bu0y
# does, so this asks for what the model will actually give. Two things make it
# free: a provider publishing a real ceiling overrides it anyway, and compaction
# only reserves this out of the window when the window is known — and it never is
# for the providers this fallback applies to.
max_tokens = 65536

[[providers]]
name = "bu0y"
base_url = "https://api.bu0y.com/v1"
api_key_env = "BU0Y_API_KEY"
# Floor on a route's recent decode speed (tokens/s). The router fills at the
# cheapest route that can deliver — and on 2026-09-02 the cheapest glm53flash
# route decoded at 4.5 tokens/s, so every call went there and 21 fills were cut
# at ~128s. A healthy marketplace pod runs ~25; this admits a slow-but-working
# pod and refuses the one that cannot finish. When nothing qualifies the call
# fails fast (503 unmet_speed) and walks the fallback ladder to another model
# rather than waiting out a fill that will not land. Comment out for no floor.
min_tokens_per_sec = 12
# Only the default is listed — the CEO fetches the full live catalog + prices
# itself (https://bu0y.com/llms.txt, https://api.bu0y.com/v1/models) and can
# hire onto ANY catalog slug as "bu0y/<slug>".
# This list is now two things: what the CEO is shown when hiring, AND the ladder a
# PAID agent falls back through when its model fails (a free agent keeps the free
# list). So order matters — cheapest and fastest first.
#
# Every entry below was probed with a real tool-calling request on 2026-08-29 and
# returned a correct tool_call. The catalog's own `tools` field marks only 3 of
# 531 models "verified" and the rest "unknown", which is missing metadata rather
# than missing support — 15 of 16 models tested answered fine, all in 3.4-10.7s
# against the 20.9s the default model averages in production. Re-probe before
# adding more; do not trust the catalog flag.
#
# Multiples are input/output cost against deepseekv4flash0731. Input dominates
# the bill here (roughly 40x more input than output tokens), so the input figure
# is the one to weigh.
paid_models = [
  "glm53flash",                 # 1.3x / 4.6x — the default seat (see model_policy):
                                #   vision, 1M context, 0 failures in 200+ calls. Its
                                #   launch-window price (18x) collapsed 2026-08-30;
                                #   input now undercuts deepseekv4flash.
  "gpt56luna",                  # 1.5x / 2.7x — the rung glm53flash fails THROUGH to
                                #   mid-call. It was on the seat ladder but not here, so
                                #   when glm53flash's gateway ceiling collapsed to 3,584
                                #   tokens on 2026-09-02 every call fell to deepseek —
                                #   the one model policy says is never a seat — because
                                #   this list is what a failing call walks, not the ladder.
  "deepseekv4flash",            # 1.37x — FALLBACK ONLY, never a seat (model_policy).
                                #   Priced on two marketplaces, so the router can fail
                                #   over; the pinned -0731 cannot.
  "deepseekv32",                # 1.5x / 1.1x  — stronger reasoning, 4.4s, 0 failures
  "minimaxm25",                 # 1.6x / 2.9x  — 3.6s
  "glm53",                      # ~2x glm5 in — the escalation seat (supersedes glm5);
                                #   1.3M ctx, tools verified. Probed 2026-09-01: correct
                                #   calls, 7.7s warm / 54.7s cold / one 502 — late in the
                                #   ladder is where that variance belongs.
  "kimik2thinking",             # 3.6x / 7.6x  — reasoning model for hard calls, 5.2s
  "deepseekv4flash0731",        # 1.0x — cheapest, but single-marketplace: it is the
                                #   one that stalled the company, so it sits late.
]
# Removed after measurement, not on principle:
#   qwen3235ba22b2507 answered a toy prompt in 3.4s and looked like the bargain of
#   the list, then failed 3 of 4 real dispatches with 524 timeouts averaging 96.8s.
#   Streaming does not save it — a large agent context takes longer to first token
#   than the edge will wait. Its sibling qwen3235ba22bthinking2507 is untested under
#   real load and is left out for the same reason until something measures it.

[[providers]]
name = "openrouter"
base_url = "https://openrouter.ai/api/v1"
api_key_env = "OPENROUTER_API_KEY"
# IMPORTANT: agents need tool calling, and the "free" auto-router slug routes to
# whatever free model is up — which usually can't call tools ("No endpoints found
# that support tool use"). List free models that DO support tools, so the CEO can
# hire employees onto them. Check the current set with:
#   curl -s https://openrouter.ai/api/v1/models | jq '.data[]
#     | select(.id|endswith(":free")) | select(.supported_parameters|index("tools")) | .id'
# Don't use "openrouter/free" anywhere, including utility_model: in practice it
# fails on every call and only appears to work because khan falls back.
# Measured before editing this list: nvidia/nemotron-3-ultra-550b-a55b:free was
# removed after failing 3 of 3 calls with a 404 from the provider - it advertises
# tool support and simply is not routable, so every fallback through it was dead
# wall-clock at the exact moment the primary model had already failed.
# z-ai/glm-5.2:free stays despite failing 12 of 12: those are upstream 429s
# ("temporarily rate-limited, retry shortly"), which is congestion rather than a
# broken model, and a 429 is parked on a cooldown in half a second rather than
# retried - so keeping it costs nothing and it earns its place again when the
# upstream frees up. Check failures with model_stats before cutting either one.
free_models = [
  "z-ai/glm-5.2:free",
  "minimax/minimax-m3:free",
]

# Add any other OpenAI-compatible endpoint the same way:
# [[providers]]
# name = "local"
# base_url = "http://localhost:11434/v1"
# api_key_env = "LOCAL_API_KEY"
# paid_models = ["llama3"]
