# Copy to khan.toml and edit. API keys come from env vars, never this file.

# Model the CEO runs on, as "provider/model". It must support tool calling.
ceo_model = "bu0y/deepseekv4flash0731"
# Cheap model for internal work like history summarization (defaults to ceo_model).
# NOT the "free" auto-router: it fails on essentially every call and only works
# because khan then falls back, which wastes a round trip each time. Name a
# concrete free model instead. minimax-m3 has a 1M context, which suits
# summarizing a long history in one pass.
utility_model = "openrouter/minimax/minimax-m3:free"

# Directory agents work in (created automatically)
workspace = "workspace"

# CEO self-reflection/evolution every N iterations
reflect_every = 10
# Max loop iterations per delegated employee task
employee_max_iters = 30
# Output ceiling sent on EVERY request. Always send one: gateways impose a small
# default when it is omitted (bu0y uses 4096), and a reasoning model will spend
# that entire budget thinking and hand back an empty answer with
# finish_reason "length". 8192-32768 suits an agent loop.
max_tokens = 16384

[[providers]]
name = "bu0y"
base_url = "https://api.bu0y.com/v1"
api_key_env = "BU0Y_API_KEY"
# Only the default is listed — the CEO fetches the full live catalog + prices
# itself (https://bu0y.com/llms.txt, https://api.bu0y.com/v1/models) and can
# hire onto ANY catalog slug as "bu0y/<slug>".
paid_models = [
  "deepseekv4flash0731",
  "glm53flash",
]

[[providers]]
name = "openrouter"
base_url = "https://openrouter.ai/api/v1"
api_key_env = "OPENROUTER_API_KEY"
# IMPORTANT: agents need tool calling, and the "free" auto-router slug routes to
# whatever free model is up — which usually can't call tools ("No endpoints found
# that support tool use"). List free models that DO support tools, so the CEO can
# hire employees onto them. Check the current set with:
#   curl -s https://openrouter.ai/api/v1/models | jq '.data[]
#     | select(.id|endswith(":free")) | select(.supported_parameters|index("tools")) | .id'
# Don't use "openrouter/free" anywhere, including utility_model: in practice it
# fails on every call and only appears to work because khan falls back.
free_models = [
  "z-ai/glm-5.2:free",
  "minimax/minimax-m3:free",
  "nvidia/nemotron-3-ultra-550b-a55b:free",
]

# Add any other OpenAI-compatible endpoint the same way:
# [[providers]]
# name = "local"
# base_url = "http://localhost:11434/v1"
# api_key_env = "LOCAL_API_KEY"
# paid_models = ["llama3"]
