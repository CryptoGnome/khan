# Copy to khan.toml and edit. API keys come from env vars, never this file.

# Model the CEO runs on, as "provider/model". It must support tool calling.
#
# Deliberately the UNPINNED slug. A dated pin like deepseekv4flash0731 fills from
# a single marketplace, and when that book empties every request returns "no seller
# is currently offering this model" — measured 0/8 during one such window while the
# unpinned slug scored 8/8 in the same minute. The router can only fail over
# between marketplaces when the model is priced on more than one. Worth 1.37x the
# per-token cost: the pinned variant took the whole company offline.
ceo_model = "bu0y/deepseekv4flash"
# Models the CEO may move ITSELF onto with set_ceo_model. ceo_model above stays
# the fail-safe floor: if a chosen model errors out, the CEO reverts to it
# automatically. Probed 2026-08-29 with a scam-refusal + capacity + urgency
# scenario: grok46 was the only model to fully handle all three (and its tools
# flag is bu0y-verified, plus 93 real production calls); claudesonnet5 had the
# sharpest reasoning at ~22x cost with a 1M context; claudeopus5 reasons best
# of all but 33.5s/call makes it a when-the-stakes-warrant-it option.
ceo_models = [
  "bu0y/grok46",         # ~17x — best all-around probe result, verified tools
  "bu0y/claudesonnet5",  # ~22x — sharpest judgment, 1M context
  "bu0y/claudeopus5",    # ~54x — deepest reasoning, slow; for high-stakes stretches
]
# Cheap model for internal work like history summarization (defaults to ceo_model).
# Never a free model here: compaction is what keeps every other call cheap, and
# free-tier 429s were blocking it at exactly the moment histories were longest —
# uncompacted history then multiplies the cost of every premium-seat call it
# feeds into. deepseekv4flash costs ~$0.002/call, fills from two marketplaces,
# and has a 1M context, which suits summarizing a long history in one pass.
utility_model = "bu0y/deepseekv4flash"

# Directory agents work in (created automatically)
workspace = "workspace"

# CEO self-reflection/evolution every N iterations
reflect_every = 10
# Max loop iterations per delegated employee task
employee_max_iters = 30
# Output ceiling sent on EVERY request, and only a fallback: where a provider
# publishes a per-model ceiling (OpenRouter does), each model gets its own.
# This value is what the rest use.
#
# Always send one: gateways impose a small default when it is omitted (bu0y uses
# 4096), and a reasoning model will spend that entire budget thinking and hand
# back an empty answer with finish_reason "length" — which is what 16384 kept
# doing to anything writing a large file in one turn.
#
# Asking high is safe for a provider that clamps rather than rejects, which bu0y
# does, so this asks for what the model will actually give. Two things make it
# free: a provider publishing a real ceiling overrides it anyway, and compaction
# only reserves this out of the window when the window is known — and it never is
# for the providers this fallback applies to.
max_tokens = 65536

[[providers]]
name = "bu0y"
base_url = "https://api.bu0y.com/v1"
api_key_env = "BU0Y_API_KEY"
# Only the default is listed — the CEO fetches the full live catalog + prices
# itself (https://bu0y.com/llms.txt, https://api.bu0y.com/v1/models) and can
# hire onto ANY catalog slug as "bu0y/<slug>".
# This list is now two things: what the CEO is shown when hiring, AND the ladder a
# PAID agent falls back through when its model fails (a free agent keeps the free
# list). So order matters — cheapest and fastest first.
#
# Every entry below was probed with a real tool-calling request on 2026-08-29 and
# returned a correct tool_call. The catalog's own `tools` field marks only 3 of
# 531 models "verified" and the rest "unknown", which is missing metadata rather
# than missing support — 15 of 16 models tested answered fine, all in 3.4-10.7s
# against the 20.9s the default model averages in production. Re-probe before
# adding more; do not trust the catalog flag.
#
# Multiples are input/output cost against deepseekv4flash0731. Input dominates
# the bill here (roughly 40x more input than output tokens), so the input figure
# is the one to weigh.
paid_models = [
  "deepseekv4flash",            # 1.37x — default. Priced on two marketplaces, so the
                                #   router can fail over; the pinned -0731 cannot.
  "deepseekv32",                # 1.5x / 1.1x  — stronger reasoning, 4.4s, 0 failures
  "minimaxm25",                 # 1.6x / 2.9x  — 3.6s
  "glm5",                       # 3.6x / 5.8x  — 4.8s
  "kimik2thinking",             # 3.6x / 7.6x  — reasoning model for hard calls, 5.2s
  "deepseekv4flash0731",        # 1.0x — cheapest, but single-marketplace: it is the
                                #   one that stalled the company, so it sits late.
  "glm53flash",                 # 18.1x / 30.2x — 0 failures in 203 calls, but pricey
]
# Removed after measurement, not on principle:
#   qwen3235ba22b2507 answered a toy prompt in 3.4s and looked like the bargain of
#   the list, then failed 3 of 4 real dispatches with 524 timeouts averaging 96.8s.
#   Streaming does not save it — a large agent context takes longer to first token
#   than the edge will wait. Its sibling qwen3235ba22bthinking2507 is untested under
#   real load and is left out for the same reason until something measures it.

[[providers]]
name = "openrouter"
base_url = "https://openrouter.ai/api/v1"
api_key_env = "OPENROUTER_API_KEY"
# IMPORTANT: agents need tool calling, and the "free" auto-router slug routes to
# whatever free model is up — which usually can't call tools ("No endpoints found
# that support tool use"). List free models that DO support tools, so the CEO can
# hire employees onto them. Check the current set with:
#   curl -s https://openrouter.ai/api/v1/models | jq '.data[]
#     | select(.id|endswith(":free")) | select(.supported_parameters|index("tools")) | .id'
# Don't use "openrouter/free" anywhere, including utility_model: in practice it
# fails on every call and only appears to work because khan falls back.
# Measured before editing this list: nvidia/nemotron-3-ultra-550b-a55b:free was
# removed after failing 3 of 3 calls with a 404 from the provider - it advertises
# tool support and simply is not routable, so every fallback through it was dead
# wall-clock at the exact moment the primary model had already failed.
# z-ai/glm-5.2:free stays despite failing 12 of 12: those are upstream 429s
# ("temporarily rate-limited, retry shortly"), which is congestion rather than a
# broken model, and a 429 is parked on a cooldown in half a second rather than
# retried - so keeping it costs nothing and it earns its place again when the
# upstream frees up. Check failures with model_stats before cutting either one.
free_models = [
  "z-ai/glm-5.2:free",
  "minimax/minimax-m3:free",
]

# Add any other OpenAI-compatible endpoint the same way:
# [[providers]]
# name = "local"
# base_url = "http://localhost:11434/v1"
# api_key_env = "LOCAL_API_KEY"
# paid_models = ["llama3"]
